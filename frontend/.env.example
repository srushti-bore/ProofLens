# ProofLens AI Frontend Environment Configuration Example
# Copy this file to .env.local for local development.
# Configure this in Vercel Project Settings > Environment Variables for production.
# NEVER place server secrets (database passwords, Gemini keys, Supabase service keys) here.

# Backend API Base URL (Must include /api/v1 prefix)
# - Local Development: http://localhost:8000/api/v1
# - Production (Render): https://your-backend-service.onrender.com/api/v1
# NOTE: Ensure your backend CORS_ORIGINS on Render includes your Vercel domain (e.g. https://your-frontend.vercel.app)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
