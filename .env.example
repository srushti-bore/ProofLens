# ProofLens AI Environment Configuration Example
# Copy this file to .env and configure local values.
# NEVER commit the real .env file or real secrets to Git.

# Application Settings
APP_ENV=development
APP_NAME=ProofLens AI
API_V1_STR=/api/v1
DEBUG=true

# Database (PostgreSQL with pgvector for production/dev; SQLite fallback for memory tests)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prooflens
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini AI Provider
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# RAG & Chunking Parameters
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.35

# Storage & Document Limits
MAX_FILE_SIZE_MB=15
MAX_DOCUMENTS_PER_WORKSPACE=10
STORAGE_DIR=./storage/docs
