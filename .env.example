# ==============================================================================
# ProofLens AI — Production & Development Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (or backend/.env) for local development or configure
#    these environment variables in your cloud provider dashboard (Render / Vercel).
# 2. NEVER commit actual .env files, private keys, or credentials to Git.
# 3. All passwords with special characters (e.g. '@', ':', '/') in URLs must be
#    percent-encoded (e.g. using urllib.parse.quote_plus).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'production', or 'test'.
# Required in production: YES (must be set to 'production')
APP_ENV=development

# Human-readable application name.
# Required: Optional (defaults to "ProofLens AI")
APP_NAME=ProofLens AI

# API prefix string.
# Required: Optional (defaults to "/api/v1")
API_V1_STR=/api/v1

# Debug mode flag. Controls verbose logging and exception stack trace visibility.
# Required in production: YES (must be set to 'false' in production; backend validator will fail if true)
DEBUG=false

# ------------------------------------------------------------------------------
# 2. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (or JSON array).
# Required in production: YES (must match the deployed Vercel frontend URL)
# Example: https://prooflens.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# ------------------------------------------------------------------------------
# 3. Database & pgvector Configuration (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Database connection string.
# Required in production: YES (must be Supabase PostgreSQL; SQLite rejected in production)
#
# IMPORTANT FOR SUPABASE:
# - SQLAlchemy async engine requires the driver prefix: postgresql+asyncpg://
# - Transaction Pooler (Recommended on Render to manage connections):
#   Host: aws-0-[region].pooler.supabase.com | Port: 6543 | User: postgres.[project-ref]
# - Session Pooler / Direct:
#   Host: db.[project-ref].supabase.co | Port: 5432 | User: postgres
# - Note: If your password contains special characters like '@', '#', '%', URL-encode them.
#
# Development (Local SQLite fallback):
DATABASE_URL=sqlite+aiosqlite:///./storage/prooflens.db
# Production (Supabase PostgreSQL with pgvector):
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?ssl=require

# Test database connection string (in-memory SQLite isolated for test suite)
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# ------------------------------------------------------------------------------
# 4. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens.
# Required in production: YES (must be at least 32 cryptographically random characters;
# default/insecure keys are rejected at startup by production validator)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-32-char-secret-key-in-production

# JWT algorithm.
# Required: Optional (defaults to HS256)
ALGORITHM=HS256

# JWT token expiration time in minutes.
# Required: Optional (defaults to 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 5. AI Provider Configuration (Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini API key for grounded Q&A, claim verification, and vector embeddings.
# Required in production: YES (Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# Generation model identifier.
# Required: Optional (defaults to gemini-3.5-flash)
GEMINI_GENERATION_MODEL=gemini-3.5-flash

# Candidate embedding model identifier.
# Required: Optional (defaults to gemini-embedding-2)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Vector output dimension matching the embedding model (e.g. 768 for gemini-embedding-2).
# Required: Optional (defaults to 768)
EMBEDDING_DIMENSION=768

# ------------------------------------------------------------------------------
# 6. RAG, Retrieval & Ingestion Tuning
# ------------------------------------------------------------------------------
# Target chunk size in tokens.
CHUNK_SIZE_TOKENS=600

# Overlap between consecutive chunks in tokens.
CHUNK_OVERLAP_TOKENS=100

# Number of candidate chunks retrieved for grounded reasoning.
RETRIEVAL_TOP_K=5

# Cosine similarity threshold below which the model explicitly abstains.
SIMILARITY_THRESHOLD=0.35

# Maximum allowed document upload file size in megabytes.
MAX_FILE_SIZE_MB=15

# Maximum allowed uploaded documents per workspace.
MAX_DOCUMENTS_PER_WORKSPACE=10

# ------------------------------------------------------------------------------
# 7. Document Storage Backend (Local Filesystem vs Supabase Storage)
# ------------------------------------------------------------------------------
# Storage backend selection:
# - 'local': Saves files to local disk under STORAGE_DIR (recommended for local development & tests)
# - 'supabase': Saves files persistently into a private Supabase Storage bucket (REQUIRED on Render)
# Required in production: YES (set to 'supabase' on Render to avoid ephemeral disk loss)
STORAGE_BACKEND=local

# Local storage base directory (used when STORAGE_BACKEND=local).
STORAGE_DIR=./storage/docs

# Supabase Project URL (REQUIRED when STORAGE_BACKEND=supabase).
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Secret Key (REQUIRED when STORAGE_BACKEND=supabase).
# Used server-side only to access and manage the private document storage bucket.
# NEVER expose this key to the frontend or browser!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# Supabase Storage bucket name for persistent user PDFs.
# Required: Optional (defaults to 'prooflens-documents'; bucket should be PRIVATE in Supabase)
SUPABASE_STORAGE_BUCKET=prooflens-documents
